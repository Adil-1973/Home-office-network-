hostname {{ d.name }}
vlan {{ d.vlan }}
 name {{ (vlans | selectattr('id', 'equalto', d.vlan) | first).name }}
vlan {{ mgmt.id }}
 name {{ mgmt.name }}
interface g0/1
 switchport mode trunk
 switchport trunk allowed vlan {{ d.vlan }},{{ mgmt.id }}
interface range f0/1 - 24
 switchport mode access
 switchport access vlan {{ d.vlan }}
 spanning-tree portfast
 spanning-tree bpduguard enable
 switchport port-security
 switchport port-security maximum 2
 switchport port-security violation restrict
interface vlan {{ mgmt.id }}
 ip address {{ d.mgmt_ip }} 255.255.255.0
ip default-gateway {{ mgmt.subnet }}.1
